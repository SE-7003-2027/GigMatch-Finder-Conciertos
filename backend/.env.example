# Este archivo es unicamente un ejemplo de las llaves que se deben configurar para que funcione correctamente el programa.
# Por ello no se expone ninguna key, solo sirve como referencia para hacer tu propio .env
# llaves db
POSTGRES_USER=usuario_gigmatch
POSTGRES_PASSWORD=password_seguro
POSTGRES_DB=gigmatch_db
DATABASE_URL=postgresql+psycopg://usuario_gigmatch:password_seguro@localhost:5432/gigmatch_db

# llaves spotify
SPOTIFY_CLIENT_ID="client_id"
SPOTIFY_CLIENT_SECRET="client_secret"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:8000/api/auth/callback"

# llave de encriptacion
ENCRYPTION_KEY="encryption_key"

# llave ticketmaster
TICKETMASTER_CONSUMER_KEY="consumer_key"